<Window x:Class="DarkAges.Viewer.MonsterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkAges.Viewer"
        Title="Monster Editor"
        Height="780" Width="1180"
        MinHeight="560" MinWidth="900"
        Background="#1B1D23"
        PreviewKeyDown="WindowKeyDown">
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252830" Padding="8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="New monster" Click="NewClicked"
                        ToolTip="Create a new MPF. Start blank, or copy frames and stats from an existing monster."/>
                <Button Content="Import frame…" Click="ImportFrameClicked"
                        ToolTip="Replace the current animation frame with a PNG or BMP"/>
                <Button Content="Add frames…" Click="AddFramesClicked"
                        ToolTip="Append one or more PNG/BMP frames"/>
                <Button Content="Save MPF…" Click="SaveMpfClicked"
                        ToolTip="Write mns####.mpf with the current sprites and animation ranges"/>
                <Button Content="Save to DAT" Click="SaveToDatClicked"
                        ToolTip="Replace or insert this mns####.mpf in hades.dat without unpacking"/>
                <Button Content="Export ▾" Click="OpenButtonMenu" Margin="12,0,0,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export pack…" Click="ExportPackClicked"
                                      ToolTip="Write JSON info, PNG frames, and an MPF you can pack into hades.dat"/>
                            <MenuItem Header="Export JSON…" Tag="json" Click="ExportDataClicked"/>
                            <MenuItem Header="Export CSV…" Tag="csv" Click="ExportDataClicked"/>
                            <MenuItem Header="Export SQL…" Tag="sql" Click="ExportDataClicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1D23" Foreground="#9AA0AE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Select a monster, or create a new one."/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Monsters" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="FilterChanged"/>
                <ListBox x:Name="MonsterList" DisplayMemberPath="ListLabel" Background="#12141A"
                         BorderBrush="#3A3F4B" SelectionChanged="MonsterSelected"/>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Height="380" Background="#12141A" BorderBrush="#3A3F4B"
                            BorderThickness="1" Margin="0,0,0,8">
                        <local:PixelPaintControl x:Name="Paint"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" x:Name="ColorVariantLabel"
                               Text="Color variants (palette swap — same frames). ★ is stored in the MPF."
                               Foreground="#9AA0AE" FontSize="11" Margin="0,0,0,4"
                               ToolTip="MPF pixels are indexed. Each mns*.pal recolors the idle frame. Click a swatch to apply it. A/B/C sibling files are separate sprites."/>
                    <ScrollViewer x:Name="ColorVariantScroller" DockPanel.Dock="Top" MaxHeight="170"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl x:Name="ColorVariantHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="64" Height="78" Margin="2" Background="#12141A"
                                            BorderBrush="#3A3F4B" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonDown="ColorVariantClicked"
                                            ToolTip="{Binding Caption}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Caption}"
                                                       Foreground="#9AA0AE" FontSize="9" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="2,0,2,2"/>
                                            <Image Source="{Binding Image}" Stretch="Uniform" Margin="2"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Frame" Foreground="#9AA0AE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="FrameLabel" DockPanel.Dock="Right" Width="64" Foreground="#E8E6E3"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="FrameSlider" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="FrameChanged"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,12,8" TextChanged="FieldChanged"/>
                        <TextBlock Grid.Column="2" Text="File" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <TextBox x:Name="FileBox" Grid.Column="3" Margin="0,0,0,8" TextChanged="FieldChanged"/>
                        <TextBlock Grid.Row="1" Text="Palette #" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                            <TextBox x:Name="PaletteBox" Width="56" TextChanged="FieldChanged"/>
                            <ComboBox x:Name="PalettePickBox" Margin="8,0,0,0" SelectionChanged="PalettePicked"
                                      ToolTip="mns*.pal files in this DAT. Changing this recolors the same frames."/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Size" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <TextBox x:Name="SizeBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" IsReadOnly="True"/>
                        <TextBlock Grid.Row="2" Text="Idle index / count" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,8">
                            <TextBox x:Name="IdleIndexBox" Width="56" TextChanged="FieldChanged"/>
                            <TextBox x:Name="IdleCountBox" Width="56" Margin="8,0,0,0" TextChanged="FieldChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Walk index / count" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="WalkIndexBox" Width="56" TextChanged="FieldChanged"/>
                            <TextBox x:Name="WalkCountBox" Width="56" Margin="8,0,0,0" TextChanged="FieldChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Attack index / count" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,8">
                            <TextBox x:Name="AttackIndexBox" Width="56" TextChanged="FieldChanged"/>
                            <TextBox x:Name="AttackCountBox" Width="56" Margin="8,0,0,0" TextChanged="FieldChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Attack 2" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="Attack2IndexBox" Width="56" TextChanged="FieldChanged"/>
                            <TextBox x:Name="Attack2CountBox" Width="56" Margin="8,0,0,0" TextChanged="FieldChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="Attack 3" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,8">
                            <TextBox x:Name="Attack3IndexBox" Width="56" TextChanged="FieldChanged"/>
                            <TextBox x:Name="Attack3CountBox" Width="56" Margin="8,0,0,0" TextChanged="FieldChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Stop-motion / %" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="StopMotionBox" Width="56" TextChanged="FieldChanged"/>
                            <TextBox x:Name="StopMotionPctBox" Width="56" Margin="8,0,0,0" TextChanged="FieldChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="Notes" Foreground="#9AA0AE" Margin="0,4,0,4"/>
                        <TextBox x:Name="NotesBox" Grid.Row="6" Grid.ColumnSpan="4" MinHeight="64"
                                 TextWrapping="Wrap" AcceptsReturn="True" TextChanged="FieldChanged"/>
                    </Grid>
                </DockPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
        <Border x:Name="NewMonsterOverlay" Background="#CC12141A" Visibility="Collapsed"
                MouseLeftButtonDown="NewMonsterOverlayClicked">
            <Border Width="460" Height="560" Background="#252830" BorderBrush="#3A3F4B" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="14"
                    MouseLeftButtonDown="NewMonsterDialogClicked">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="New monster" FontSize="16" FontWeight="SemiBold"
                               Foreground="#E8E6E3" Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,0,0,10"
                               Text="Start blank, or pick an existing sprite to copy frames, palette, and animation ranges into a new file."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Blank" Click="NewBlankClicked" Width="88"
                                ToolTip="Create an empty 48×48 sprite"/>
                        <Button Content="Copy selected" Click="NewCopyClicked" Width="120" Margin="8,0,0,0"
                                ToolTip="Duplicate the highlighted monster as a new editable file"/>
                        <Button Content="Cancel" Click="NewCancelClicked" Width="88" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="120" Background="#12141A" BorderBrush="#3A3F4B"
                            BorderThickness="1" Margin="0,0,0,8">
                        <Image x:Name="ClonePreview" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBox x:Name="CloneFilterBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                             TextChanged="CloneFilterChanged"/>
                    <ListBox x:Name="CloneList" DisplayMemberPath="ListLabel" Background="#12141A"
                             BorderBrush="#3A3F4B" SelectionChanged="CloneListSelected"
                             MouseDoubleClick="CloneListDoubleClicked"/>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
