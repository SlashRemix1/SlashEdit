<Window x:Class="DarkAges.Viewer.RandomizeMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Randomize map"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1D23">
    <StackPanel Margin="16" Width="360">
        <TextBlock TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,0,0,12"
                   Text="Ground stays in the base tile's family. Paths use the floor family that borders it most often on existing maps. Known bands such as grass, grass pathing, wood, crypt, water, and bridge stay split. Other runs of tiles are grouped from the maps."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Width" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="WidthBox" Text="20"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="HeightBox" Text="20"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Base floor ID" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="FloorBox" Text="278" TextChanged="IdsChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Path floor (0 = auto)" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="PathBox" Text="0" TextChanged="IdsChanged"/>
            </StackPanel>
            <Border Grid.Column="2" Height="48" Background="#12141A" BorderBrush="#3A3F4B" BorderThickness="1" VerticalAlignment="Bottom">
                <Image x:Name="FloorPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </Grid>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Base wall ID" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="WallBox" Text="4209" TextChanged="IdsChanged"/>
                <TextBlock x:Name="WallHint" TextWrapping="Wrap" FontSize="11" Foreground="#9AA0AE" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" Height="64" Background="#12141A" BorderBrush="#3A3F4B" BorderThickness="1" VerticalAlignment="Top" Margin="0,18,0,0">
                <Image x:Name="WallPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </Grid>
        <TextBlock Text="Buildings" Foreground="#9AA0AE" Margin="0,12,0,4"/>
        <DockPanel>
            <TextBlock x:Name="BuildingLabel" DockPanel.Dock="Right" Width="28" Foreground="#E8E6E3" Text="6"/>
            <Slider x:Name="BuildingSlider" Minimum="0" Maximum="24" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="BuildingChanged"/>
        </DockPanel>
        <TextBlock Text="Extra paths" Foreground="#9AA0AE" Margin="0,8,0,4"/>
        <DockPanel>
            <TextBlock x:Name="PathLabel" DockPanel.Dock="Right" Width="28" Foreground="#E8E6E3" Text="2"/>
            <Slider x:Name="PathSlider" Minimum="0" Maximum="8" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"
                    ToolTip="Extra wandering trails besides the paths that already join the buildings."
                    ValueChanged="PathChanged"/>
        </DockPanel>
        <TextBlock Text="Seed (0 = random)" Foreground="#9AA0AE" Margin="0,8,0,4"/>
        <TextBox x:Name="SeedBox" Text="0"/>
        <TextBlock x:Name="ScanLabel" Foreground="#9AA0AE" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Generate" IsDefault="True" Click="GenerateClicked" Width="96" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Width="88"/>
        </StackPanel>
    </StackPanel>
</Window>
