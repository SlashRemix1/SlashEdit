<Window x:Class="DarkAges.Viewer.SotpEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkAges.Viewer"
        Title="Walk flags (sotp)"
        Height="720" Width="980"
        MinHeight="480" MinWidth="760"
        Background="#1B1D23">
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252830" Padding="8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="Category" Foreground="#9AA0AE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CategoryBox" Width="180" SelectionChanged="FilterChanged"/>
                <TextBox x:Name="FilterBox" Width="120" Margin="8,0,0,0" TextChanged="FilterChanged"
                         ToolTip="Wall id"/>
                <Button Content="Walk (0)" Click="WalkClicked" Margin="12,0,0,0"
                        ToolTip="sotp = 0. Players can walk this wall overlay."/>
                <Button Content="Tab block (15)" Click="BlockClicked" Margin="8,0,0,0"
                        ToolTip="sotp = 15. Tab map treats this tile as blocked."/>
                <Button Content="Overlay (128)" Click="OverlayClicked" Margin="8,0,0,0"
                        ToolTip="sotp bit 0x80. Additive/glass blit."/>
                <Button Content="Save to DAT" Click="SaveClicked" Margin="12,0,0,0"
                        ToolTip="Write sotp.dat back into ia.dat"/>
                <Button Content="Export ▾" Click="OpenButtonMenu" Margin="8,0,0,0"
                        ToolTip="Write walk flags as JSON, CSV, or SQL">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export JSON…" Tag="json" Click="ExportDataClicked"/>
                            <MenuItem Header="Export CSV…" Tag="csv" Click="ExportDataClicked"/>
                            <MenuItem Header="Export SQL…" Tag="sql" Click="ExportDataClicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1D23" Foreground="#9AA0AE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="sotp[wallId-1]. Tab map uses 15. Any non-zero byte blocks walking."/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="WallList" Margin="8" DisplayMemberPath="Label" SelectionChanged="WallSelected"
                     Background="#12141A" BorderBrush="#3A3F4B"/>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2" Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock x:Name="DetailText" Foreground="#E8E6E3" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DockPanel>
                        <TextBlock Text="sotp byte" Foreground="#9AA0AE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ValueBox" Width="64" LostFocus="ValueCommitted" KeyDown="ValueKeyDown"/>
                    </DockPanel>
                </StackPanel>
                <Border Background="#12141A" BorderBrush="#3A3F4B" BorderThickness="1">
                    <Image x:Name="WallImage" Stretch="Uniform" Margin="16"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
    <local:BusyOverlay x:Name="BusyHost"/>
    </Grid>
</Window>
