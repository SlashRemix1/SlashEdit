<Window x:Class="DarkAges.Viewer.PaletteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palette Editor"
        Height="760" Width="1100"
        MinHeight="520" MinWidth="840"
        Background="#1B1D23">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252830" Padding="8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="New palette" Click="NewPaletteClicked"
                        ToolTip="Create a blank 256-color palette and insert it into the selected DAT"/>
                <Button Content="Save to DAT" Click="SaveClicked" Margin="8,0,0,0"
                        ToolTip="Write this .pal or .tbl back into the client DAT without unpacking"/>
                <Button Content="Export ▾" Click="OpenButtonMenu" Margin="8,0,0,0"
                        ToolTip="Write this palette or table as JSON, CSV, or SQL">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export JSON…" Tag="json" Click="ExportDataClicked"/>
                            <MenuItem Header="Export CSV…" Tag="csv" Click="ExportDataClicked"/>
                            <MenuItem Header="Export SQL…" Tag="sql" Click="ExportDataClicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Dye layout 96–101" Click="DyeLayoutClicked" Margin="8,0,0,0"
                        ToolTip="Write the stock clothing dye ramp into indices 96–101"/>
                <Button Content="Copy dye slots…" Click="CopyDyeClicked" Margin="8,0,0,0"
                        ToolTip="Copy indices 96–101 from another palette onto this one"/>
                <Button Content="Remap from…" Click="RemapFromClicked" Margin="8,0,0,0"
                        ToolTip="Copy another palette onto this file and keep this file's dye slots 96–101"/>
                <Button Content="Add table row" Click="AddRowClicked" Margin="8,0,0,0"/>
                <Button Content="Remove table row" Click="RemoveRowClicked" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1D23" Foreground="#9AA0AE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Select a palette or table."/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="8">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="FilterChanged"/>
                <ListBox x:Name="FileList" DisplayMemberPath="Label" Background="#12141A"
                         BorderBrush="#3A3F4B" SelectionChanged="FileSelected"/>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2" Margin="8">
                <ScrollViewer x:Name="SwatchHost" VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="SwatchGrid" Columns="16" Rows="16"/>
                </ScrollViewer>
                <DataGrid x:Name="TableGrid" Visibility="Collapsed" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Min" Binding="{Binding Minimum}" Width="80"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Maximum}" Width="80"/>
                        <DataGridTextColumn Header="Palette" Binding="{Binding PaletteNumber}" Width="90"/>
                        <DataGridTextColumn Header="Misc" Binding="{Binding Misc}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="OriginGrid" Visibility="Collapsed" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Frame" Binding="{Binding Frame}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Origin X" Binding="{Binding X}" Width="90"/>
                        <DataGridTextColumn Header="Origin Y" Binding="{Binding Y}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
