<Window x:Class="DarkAges.Viewer.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paint macros"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1D23"
        PreviewKeyDown="WindowPreviewKeyDown">
    <DockPanel Margin="12" Width="640">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,0,0,10"
                   Text="Select a floor, left/right wall, or structure preset in the editor, then click Set on a slot. Keys 0–9 switch the paint tool to that stamp. Click a picture to use it."/>
        <ItemsControl x:Name="SlotHost">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="2" Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Padding="6" Background="#252830" BorderBrush="#3A3F4B" BorderThickness="1"
                            Width="116">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Caption}" FontWeight="SemiBold"
                                       Foreground="#E8E6E3" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Button DockPanel.Dock="Bottom" Content="Clear" Margin="0,4,0,0" Padding="2,2"
                                    Click="ClearClicked" Tag="{Binding Key}"/>
                            <Button DockPanel.Dock="Bottom" Content="Set" Margin="0,4,0,0" Padding="2,2"
                                    Click="SetClicked" Tag="{Binding Key}"
                                    ToolTip="Bind the stamp currently selected in the editor"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Foreground="#9AA0AE"
                                       FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" Height="28" TextWrapping="Wrap"/>
                            <Border Height="72" Background="#12141A" BorderBrush="#3A3F4B" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="PreviewClicked" Tag="{Binding Key}"
                                    ToolTip="Click to use this stamp">
                                <Image Source="{Binding Image}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
