<Window x:Class="DarkAges.Viewer.ImportCinematicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import cinematic"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1D23">
    <StackPanel Margin="16" Width="420">
        <TextBlock TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,0,0,12"
                   Text="Replace or add a .bik in a DAT. An existing Bink 1 file is written as-is. MP4, AVI, MKV, MOV, and WebM are converted with RAD Video Tools (FFmpeg cannot encode Bink)."/>
        <TextBlock Text="Video" Foreground="#9AA0AE" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseClicked" Width="88" Margin="8,0,0,0"/>
            <TextBox x:Name="PathBox" IsReadOnly="True"/>
        </DockPanel>
        <TextBlock Text="DAT" Foreground="#9AA0AE" Margin="0,0,0,4"/>
        <ComboBox x:Name="CatalogBox" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>
        <TextBlock Text="Entry name" Foreground="#9AA0AE" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Text="intro.bik" Margin="0,0,0,8"/>
        <TextBlock x:Name="ToolHint" TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save to DAT" IsDefault="True" Click="SaveClicked" Width="108" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Width="88"/>
        </StackPanel>
    </StackPanel>
</Window>
