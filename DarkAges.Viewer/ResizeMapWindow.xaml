<Window x:Class="DarkAges.Viewer.ResizeMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize map"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1D23">
    <StackPanel Margin="16" Width="320">
        <TextBlock x:Name="CurrentSizeText" Foreground="#E8E6E3" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,0,0,12"
                   Text="Positive values add tiles on that side. Negative values remove the same number of tiles from that side."/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="10"/>
                <RowDefinition/>
                <RowDefinition Height="10"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Y up" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="UpBox" Text="0" TextChanged="ValuesChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="X left" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="LeftBox" Text="0" TextChanged="ValuesChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="4">
                <TextBlock Text="X right" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="RightBox" Text="0" TextChanged="ValuesChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
                <TextBlock Text="Y down" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                <TextBox x:Name="DownBox" Text="0" TextChanged="ValuesChanged"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="NewSizeText" Foreground="#E8E6E3" Margin="0,14,0,0"/>
        <TextBlock Text="Fill floor ID for new tiles" Foreground="#9AA0AE" Margin="0,12,0,4"/>
        <TextBox x:Name="FillBox" Text="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Apply" IsDefault="True" Click="ApplyClicked" Width="88" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Width="88"/>
        </StackPanel>
    </StackPanel>
</Window>
