<Window x:Class="DarkAges.Viewer.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PNG converter"
        Height="640" Width="980"
        MinHeight="480" MinWidth="760"
        Background="#1B1D23">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252830" Padding="8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="Open PNG…" Click="OpenClicked"
                        ToolTip="Load a PNG or BMP to quantize into a Dark Ages graphic"/>
                <Button Content="Save to DAT" Click="SaveDatClicked" Margin="8,0,0,0"
                        ToolTip="Write the converted file (and companion .pal when needed) into the selected DAT"/>
                <Button Content="Save files…" Click="SaveFilesClicked" Margin="8,0,0,0"
                        ToolTip="Write the converted graphic and optional .pal next to each other on disk"/>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1D23" Foreground="#9AA0AE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Open a PNG, pick EPF/MPF/HPF/EFA/SPF, then save."/>
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#12141A" BorderBrush="#3A3F4B" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Format" Foreground="#9AA0AE" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FormatBox" SelectionChanged="OptionsChanged"/>
                    <TextBlock Text="DAT" Foreground="#9AA0AE" Margin="0,12,0,4"/>
                    <ComboBox x:Name="CatalogBox" DisplayMemberPath="DisplayName"/>
                    <TextBlock Text="Entry name" Foreground="#9AA0AE" Margin="0,12,0,4"/>
                    <TextBox x:Name="NameBox"/>
                    <TextBlock Text="Palette" Foreground="#9AA0AE" Margin="0,12,0,4"/>
                    <ComboBox x:Name="PaletteBox" DisplayMemberPath="Name" SelectionChanged="OptionsChanged"/>
                    <CheckBox x:Name="DitherBox" Content="Floyd–Steinberg dither" Margin="0,10,0,0" Click="OptionsChanged"/>
                    <CheckBox x:Name="DyeBox" Content="Keep dye slots 96–101" IsChecked="True" Margin="0,6,0,0"/>
                    <TextBlock Text="EFA origin / MPF pal #" Foreground="#9AA0AE" Margin="0,12,0,4"/>
                    <DockPanel>
                        <TextBox x:Name="OriginXBox" Width="70" Text="28" Margin="0,0,6,0"/>
                        <TextBox x:Name="OriginYBox" Width="70" Text="70" Margin="0,0,6,0"/>
                        <TextBox x:Name="PalNumBox" Text="0"/>
                    </DockPanel>
                    <TextBlock Text="EFA blend" Foreground="#9AA0AE" Margin="0,12,0,4"/>
                    <ComboBox x:Name="BlendBox"/>
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="#9AA0AE" Margin="0,16,0,0"
                               Text="Index 0 is transparent. Palettized formats get a companion .pal unless you pick an existing one."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
