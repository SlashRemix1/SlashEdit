<Window x:Class="DarkAges.Viewer.WarpCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warp check"
        Height="640" Width="980"
        MinHeight="400" MinWidth="720"
        Background="#1B1D23"
        xmlns:local="clr-namespace:DarkAges.Viewer">
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252830" Padding="8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="Run check" Click="RunClicked"
                        ToolTip="Missing dest maps, out-of-bounds tiles, one-way warps, and unset landings"/>
                <CheckBox x:Name="UnusedBox" Content="Include unused maps" VerticalAlignment="Center" Margin="12,0,0,0"
                          Foreground="#E8E6E3"
                          ToolTip="Also list maps that have no warps in or out"/>
                <Button Content="Go to map" Click="GoSourceClicked" Margin="12,0,0,0"/>
                <Button Content="Jump dest" Click="GoDestClicked" Margin="8,0,0,0"/>
                <Button Content="Export ▾" Click="OpenButtonMenu" Margin="12,0,0,0"
                        ToolTip="Write the issue list as JSON, CSV, or SQL">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export JSON…" Tag="json" Click="ExportDataClicked"/>
                            <MenuItem Header="Export CSV…" Tag="csv" Click="ExportDataClicked"/>
                            <MenuItem Header="Export SQL…" Tag="sql" Click="ExportDataClicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1D23" Foreground="#9AA0AE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Run check to scan warps for this client."/>
            </StatusBarItem>
        </StatusBar>
        <DataGrid x:Name="IssueGrid" Margin="8"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  MouseDoubleClick="IssueOpened">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="72"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="140"/>
                <DataGridTextColumn Header="Map" Binding="{Binding MapLabel}" Width="180"/>
                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="80"/>
                <DataGridTextColumn Header="Dest" Binding="{Binding DestLabel}" Width="180"/>
                <DataGridTextColumn Header="Landing" Binding="{Binding Landing}" Width="90"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    <local:BusyOverlay x:Name="BusyHost"/>
    </Grid>
</Window>
