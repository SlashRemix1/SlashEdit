<Window x:Class="DarkAges.Viewer.WarpEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warp Editor"
        Height="720" Width="1180"
        MinHeight="480" MinWidth="900"
        Background="#1B1D23"
        xmlns:local="clr-namespace:DarkAges.Viewer">
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252830" Padding="8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button Content="New" Click="NewClicked"
                        ToolTip="Add a blank warp. Set source map, tile, and destination, then Save."/>
                <Button Content="Delete" Click="DeleteClicked"/>
                <Button Content="Save" Click="SaveClicked"
                        ToolTip="Write authored and imported warps for this client in AppData"/>
                <Button Content="Import ▾" Click="OpenButtonMenu" Margin="12,0,0,0"
                        ToolTip="Load JSON, CSV, XML, SQL, TMap, or a folder of dumps">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Import file…" Click="ImportFileClicked"
                                      ToolTip="JSON, CSV, XML, SQL, or LoD TMap. Column names can differ per client."/>
                            <MenuItem Header="Import folder…" Click="ImportFolderClicked"
                                      ToolTip="Scan a folder of dumps (Fragments, LoD TMap, Hybrasyl XML, SQL, CSV)."/>
                            <MenuItem Header="Import areas…" Click="ImportAreasClicked"
                                      ToolTip="JSON/CSV/XML/SQL area dump with map id + name."/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Export ▾" Click="OpenButtonMenu"
                        ToolTip="Write the current list as JSON, CSV, or SQL">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export JSON…" Tag="json" Click="ExportClicked"/>
                            <MenuItem Header="Export CSV…" Tag="csv" Click="ExportClicked"/>
                            <MenuItem Header="Export SQL…" Tag="sql" Click="ExportClicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Go to map" Click="GoSourceClicked" Margin="12,0,0,0"
                        ToolTip="Open the source map and scroll to this warp tile"/>
                <Button Content="Jump dest" Click="GoDestClicked"
                        ToolTip="Open the destination map in the Map Editor. Alt+click opens a second window."/>
                <Button Content="Check…" Click="CheckClicked"
                        ToolTip="Full report: missing dests, bounds, overlaps, one-way, unused maps"/>
                <CheckBox x:Name="IssuesOnlyBox" Content="Issues only" VerticalAlignment="Center" Margin="12,0,0,0"
                          Foreground="#E8E6E3"
                          ToolTip="Show warps that fail validation"
                          Checked="FilterToggled" Unchecked="FilterToggled"/>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1D23" Foreground="#9AA0AE">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="All warps for this client. Import a dump if the client has no TMap."/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="8">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                         TextChanged="FilterChanged"
                         ToolTip="Filter by map id, map name, dest map, dest name, label, or issue kind"/>
                <DataGrid x:Name="WarpGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionChanged="WarpSelected"
                          MouseDoubleClick="WarpDoubleClicked"
                          PreviewKeyDown="GridKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Map" Binding="{Binding MapId}" Width="64"/>
                        <DataGridTextColumn Header="Map name" Binding="{Binding MapName}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X1}" Width="44"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y1}" Width="44"/>
                        <DataGridTextColumn Header="X2" Binding="{Binding X2}" Width="44"/>
                        <DataGridTextColumn Header="Y2" Binding="{Binding Y2}" Width="44"/>
                        <DataGridTextColumn Header="Dest map" Binding="{Binding DestMapId}" Width="72"/>
                        <DataGridTextColumn Header="Dest name" Binding="{Binding DestMapName}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Dest X" Binding="{Binding DestX}" Width="58"/>
                        <DataGridTextColumn Header="Dest Y" Binding="{Binding DestY}" Width="58"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Destination}" Width="120"/>
                        <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="72" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Problems" Binding="{Binding Problems}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Source map" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MapIdBox" Grid.Column="1" Margin="0,0,0,8"
                              LostFocus="DetailLostFocus" SelectionChanged="MapPicked"
                              ToolTip="Type a map number or name, or pick from the list"/>
                    <TextBlock Grid.Row="1" Text="Map name" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="MapNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Text="X" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="X1Box" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="3" Text="Y" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="Y1Box" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="4" Text="X2" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="X2Box" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="5" Text="Y2" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="Y2Box" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="6" Text="Dest map" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DestMapBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                              LostFocus="DetailLostFocus" SelectionChanged="MapPicked"
                              ToolTip="Type a map number or name, or pick from the list"/>
                    <TextBlock Grid.Row="7" Text="Dest name" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="DestMapNameBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
                    <TextBlock Grid.Row="8" Text="Dest X" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="DestXBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="9" Text="Dest Y" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="DestYBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="10" Text="Label" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,8" LostFocus="DetailLostFocus"/>
                    <TextBlock Grid.Row="11" Text="Origin" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                    <TextBox x:Name="OriginBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
                    <TextBlock Grid.Row="12" Text="Check" Foreground="#9AA0AE" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <TextBlock x:Name="IssueText" Grid.Row="12" Grid.Column="1" Foreground="#E8B86D" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="13" Grid.ColumnSpan="2" Foreground="#9AA0AE" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Pick source and dest maps by name or number. Jump dest uses the current Map Editor; Alt+click opens a second window. Problems column is live validation."/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
    <local:BusyOverlay x:Name="BusyHost"/>
    </Grid>
</Window>
