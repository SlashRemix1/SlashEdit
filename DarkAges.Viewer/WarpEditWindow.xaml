<Window x:Class="DarkAges.Viewer.WarpEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warp"
        Height="420" Width="520"
        MinHeight="380" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#1B1D23">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Go" Width="72" Margin="0,0,8,0" Click="GoClicked"
                    ToolTip="Open the destination in this Map Editor. Alt+click Go for a second window."/>
            <Button Content="Delete" Width="72" Margin="0,0,8,0" Click="DeleteClicked"/>
            <Button Content="Save" Width="72" Margin="0,0,8,0" IsDefault="True" Click="SaveClicked"/>
            <Button Content="Cancel" Width="72" IsCancel="True" Click="CancelClicked"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Source map" Foreground="#9AA0AE" VerticalAlignment="Center"/>
            <ComboBox x:Name="MapIdBox" Grid.Column="1" Margin="0,0,0,8"
                      ToolTip="Type a map number or name, or pick from the list"/>
            <TextBlock Grid.Row="1" Text="Source tiles" Foreground="#9AA0AE" VerticalAlignment="Center"/>
            <TextBox x:Name="RectBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"/>
            <TextBlock Grid.Row="2" Text="Dest map" Foreground="#9AA0AE" VerticalAlignment="Center"/>
            <ComboBox x:Name="DestMapBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                      ToolTip="Type a map number or name, or pick from the list"/>
            <TextBlock Grid.Row="3" Text="Dest X" Foreground="#9AA0AE" VerticalAlignment="Center"/>
            <TextBox x:Name="DestXBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Text="Dest Y" Foreground="#9AA0AE" VerticalAlignment="Center"/>
            <TextBox x:Name="DestYBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Text="Label" Foreground="#9AA0AE" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="IssueText" Grid.Row="6" Grid.ColumnSpan="2" Foreground="#E8B86D" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="7" Text="Pick maps by name or number. Go opens the destination in this Map Editor. Alt+click Go for a second window. Light blue tiles are exits; yellow tiles are landings."
                       Grid.ColumnSpan="2" Foreground="#9AA0AE" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
    </DockPanel>
</Window>
